# Export these in your shell; .env files are intentionally not auto-loaded.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TOOL_MODE=structured
# Optional hosted provider: set LLM_PROVIDER=openai and configure below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
